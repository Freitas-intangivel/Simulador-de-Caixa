Algoritmo "caixa"
// 
//  
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : G2
// Data atual  : 11/05/2026
Var
// Seção de Declarações das variáveis 
opcao, cont, contar, ven, reset: inteiro
entregue, restante, ssaldo, dsaldo,msaldo,csaldo,psaldo, total: real
produtos: vetor[0..15] de caractere
precos: vetor[0..15] de real
venda: vetor[1..99] de inteiro
Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
ssaldo <- 80.00  //Saldo inicial do caixa em dinheiro

produtos[1] <- "Arroz"
precos[1] <- 20
produtos[2] <- "Feijao"
precos[2] <- 10
produtos[3] <- "Macarrao"
precos[3] <- 8
produtos[4] <- "Carne"
precos[4] <- 35
produtos[5] <- "Leite"
precos[5] <- 5
produtos[6] <- "Pao"
precos[6] <- 7
produtos[7] <- "Café"
precos[7] <- 15
produtos[8] <- "Açucar"
precos[8] <- 6
produtos[9] <- "Óleo"
precos[9] <- 9
produtos[10] <- "Sal"
precos[10] <- 3
produtos[11] <- "Refrigerante"
precos[11] <- 6
produtos[12] <- "Bolacha"
precos[12] <- 4
produtos[13] <- "Queijo"
precos[13] <- 12
produtos[14] <- "Presunto"
precos[14] <- 11
produtos[15] <- "Frango"
precos[15] <- 25


escreval(" _________________________________________________")
escreval("|Mercadão Duscara                                 |")
escreval("| 1-Registrar Venda 2-Histórico 3-Relatório Final |")
escreval("|                                                 |")
escreval("|                                                 |")
escreval("|                                                 |")
escreval("|                                                 |")
escreval("| Dinheiro: R$", ssaldo, "    Maquininha: R$", msaldo)
escreval("|_________________________________________________|")
escreval("")
leia (opcao)
escolha opcao
caso (1)  //Registrar vendas
escreval(" _________________________________________________")
escreval("|                                                 ")
para cont de 1 ate 15 faca
escreval("|", cont, " - ", produtos[cont], " R$",precos[cont])
fimpara
escreval("|_________________________________________________")
cont <- 0

repita

escreval(" _________________________________________________")
escreval("|                                                 |")
escreval("|   Quais produtos serão comprados? 0-Finalizar   |")
escreval("|_________________________________________________|")
repita
cont <- cont + 1
leia (ven)
venda[cont] <- ven
total <- total + precos[venda[cont]]
ate ven = 0

contar <- 1
escreval(" _________________________________________________")
escreval("|                                                 ")
enquanto precos[venda[contar]] <> 0 faca
escreval("|  ", produtos[venda[contar]]," R$", precos[venda[contar]])
contar <- contar + 1
fimenquanto
escreval ("|                                                 ")
escreval ("|   Total: R$", total)
escreval ("|_________________________________________________")

se ven = 0 entao
cont <- cont -1
fimse

escreval(" _________________________________________________")
escreval("|                                                 |")
escreval("|         1-Continuar   2-Adicionar Mais          |")
escreval("|_________________________________________________|")
leia (opcao)
ate opcao <> 2

se opcao = 1 entao

escreval(" _________________________________________________")
escreval("|Forma de Pagamento                               |")
escreval("|                1 - Dinheiro                     |")
escreval("|                2 - Debito                       |")
escreval("|                3 - Crédito                      |")
escreval("|                4 - PIX                          |")
escreval("|_________________________________________________|")

leia (opcao)
escolha opcao

caso(1) //Dinheiro
escreval (" Total: R$", total)
escreva("Dinheiro entregue: R$")
leia (entregue)
restante <- entregue - total
escreval ("Troco: R$", restante)

se restante < 0 entao
escreval("")
escreval ("Faltam", (-1 * restante), " reais, finalizar com outro metodo?")
fimse

caso(2)  //Debito
escreval (" Total: R$", total)
escreva("Cobrar: R$")
leia (entregue)
restante <- entregue - total
escreval ("Troco: R$", restante)

se restante < 0 entao
escreval("")
escreval ("Faltam", (-1 * restante), " reais, finalizar com outro metodo?")
fimse

caso(3)  //Crédito
escreval (" Total: R$", total)
escreva("Cobrar: R$")
leia (entregue)
restante <- entregue - total
escreval ("Troco: R$", restante)

se restante < 0 entao
escreval("")
escreval ("Faltam", (-1 * restante), " reais, finalizar com outro metodo?")
fimse

caso(4)  //Pix
escreval (" Total: R$", total)
escreva("Cobrar: R$")
leia (entregue)
restante <- entregue - total
escreval ("Troco: R$", restante)

se restante < 0 entao
escreval("")
escreval ("Faltam", (-1 * restante), " reais, finalizar com outro metodo?")
fimse


fimescolha
fimse

caso (2)  //Historico de vendas



caso (3) //Relatorio final


outrocaso

fimescolha
Fimalgoritmo
